# Copiar a /opt/gunbound/prod.env (y a /opt/gunbound/prueba.env con los valores de prueba) y completar.
# Los lee `docker compose --env-file …` (ver despliegue/LEEME.md).

# prod | prueba  (el contenedor: gunbound-prod / gunbound-prueba)
GB_ENTORNO=prod

# los puertos (prueba: todo +1000 → 9372 / 9370 / 9371)
GB_PUERTO_BROKER=8372
GB_PUERTO_MUNDO=8370
GB_PUERTO_HTTP=8371
# el canje escucha sólo adentro de la máquina: afuera se publica con HTTPS (Caddy), porque el boleto es un secreto
GB_ESCUCHA_HTTP=127.0.0.1

# la IP PÚBLICA de la máquina (o un nombre: se resuelve al anunciar). Es la que el broker le da al cliente para el
#   mundo. Vacía = la IP por la que el cliente llegó al broker (sirve en la LAN; en un VPS detrás de NAT, ponerla)
GB_IP_PUBLICA=
# lo que el canje le dice al launcher para escribir en el registro del cliente: "host:puerto" del BROKER
GB_BROKER_PUBLICO=juego.eñeños.link:8372

# el pase de Cuenta Eñeños. El `aud` (vacío = gunbound en prod, gunbound-prueba en prueba)
GB_PASE_JUEGO=
# la clave PÚBLICA de Cuenta Eñeños (base64url de 32 bytes, 64 hex o el JWKS). Si está, el server no sale a buscarla…
GB_CUENTAS_CLAVE_PUBLICA=
# …y si no, la pide UNA vez al arrancar a <URL>/clave-publica
GB_CUENTAS_URL=https://eñeños.link/cuentas

# lo que se ve
GB_NOMBRE_MUNDO=Eñeños
GB_DESCRIPCION_MUNDO=Avatar ON
GB_ANUNCIO_CANAL=

# la cuenta nueva nace con esto
GB_ORO_INICIAL=100000
GB_CASH_INICIAL=20000

# los Eñeños ID con comandos de GM (/aviso, /quien, /dar), separados por coma
GB_GM=

# cómo se hablan los jugadores en la sala y la partida: vacío/directo = UDP entre ellos (puerto 8363) y, si en 2 s
#   no contesta, por el TÚNEL del server (parche 6 del cliente) · tunel = todo por el server desde el principio
#   (sólo para probar varios clientes en una misma PC)
GB_P2P=

# 1 = anota cada mensaje (para medir; pesa en el log). En prod, vacío
GB_TRAZA=

# % de que el móvil «aleatorio» salga Dragón o Caballero (mitad y mitad). Vacío = 5 (como el Serv3 de Perú)
GB_ESPECIALES=

# dónde quedan los jugadores (una carpeta por entorno). Es lo ÚNICO que hay que llevar al mudarse
GB_ESTADO_DIR=/opt/gunbound/estado-prod
